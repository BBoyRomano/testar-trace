timeout 10.0
external 'extern'

def Left_Click_at_button_x_to_Student_s_View()
  receive 'click', constraint: %(css == "" && text == "button_x")
  send 'page_title', constraint: %(_title == "Student's View")
end

def Left_Click_at_button_unenroll_subject_to_Student_s_View()
  receive 'click', constraint: %(css == "" && text == "button_unenroll_subject")
  send 'page_title', constraint: %(_title == "Student's View")
end

def Set_Webdriver_select_list_script_to_set_into_ID_stu_mySubjects_unenrollSubjectModal_subjectSelect_164_to_Student_s_View()
  receive 'click', constraint: %(css == "" && text == "")
  send 'page_title', constraint: %(_title == "Student's View")
end

def Left_Click_at_button_cancel_to_Student_s_View()
  receive 'click', constraint: %(css == "" && text == "button_cancel")
  send 'page_title', constraint: %(_title == "Student's View")
end

process('testar') {

  channel('extern') {
    stimulus 'visit', '_url' => :string
    stimulus 'click', 'css' => :string, 'text' => :string
    stimulus 'fill_in', 'selector' => :string, 'value' => :string
    response 'page_title', '_title' => :string, '_url' => :string
  }

  behavior('launch') {
    receive 'visit',
    constraint: "_url == initial_url"
    send 'page_title',
    constraint: %(_title == "Student's View")
