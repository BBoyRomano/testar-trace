4\">\n            \n\n\n\n\n\n\n\n\n    <div id=\"side-menu-panel\" class=\"bootstrap-vertical-nav\">\n        <ul id=\"menu\" class=\"nav nav-pills flex-column\">\n            <li class=\"nav-item\">\n                <a id=\"tea.menu.overview\" class=\"nav-link active\" href=\"/uis-web/teacher-view/overview\" title=\"Overview tooltip\">Overview</a>\n            </li>\n            <li class=\"nav-item\">\n                <a id=\"tea.menu.mySubjects\" class=\"nav-link\" href=\"/uis-web/teacher-view/mySubjects\" title=\"My Subjects tooltip\">My Subjects</a>\n            </li>\n            <li class=\"nav-item\">\n                <a id=\"tea.menu.myExamDates\" class=\"nav-link\" href=\"/uis-web/teacher-view/myExamDates\" title=\"My Exam Dates tooltip\">My Exam Dates</a>\n            </li>\n            <li class=\"nav-item\">\n                <a id=\"tea.menu.newExamDates\" class=\"nav-link\" href=\"/uis-web/teacher-view/newExamDates\" title=\"New Exam Dates tooltip\">New Exam Dates</a>\n            </li>\n            <li class=\"nav-item\">\n                <a id=\"tea.menu.setEvaluation\" class=\"nav-link\" href=\"/uis-web/teacher-view/setEvaluation\" title=\"Set Evaluation tooltip\">Set Evaluation</a>\n            </li>\n            <li class=\"nav-item\">\n                <a id=\"tea.menu.evaluationTable\" class=\"nav-link\" href=\"/uis-web/teacher-view/evaluationTable\" title=\"Evaluation Table tooltip\">Evaluation Table</a>\n            </li>\n            <li class=\"nav-item\">\n                <a id=\"tea.menu.otherSubjects\" class=\"nav-link\" href=\"/uis-web/teacher-view/otherSubjects\" title=\"Others' Subjects tooltip\">Others' Subjects</a>\n            </li>\n            <li class=\"nav-item\">\n                <a id=\"tea.menu.listOfAllTeachers\" class=\"nav-link\" href=\"/uis-web/teacher-view/listOfAllTeachers\" title=\"List of All Teachers tooltip\">List of All Teachers</a>\n            </li>\n        </ul>\n    </div>\n\n        </div>\n\n        <div id=\"content\" class=\"col-8\">\n            <!-- Actual view -->\n            \n                \n                    \n\n\n\n\n<form id=\"overview.personalInfoForm\" method=\"POST\">\n    <div class=\"form-group row\">\n        <label id=\"overview.firstNameLabel\" for=\"overview.firstName\" class=\"col-sm-2 control-label\">First name</label>\n        <div class=\"col-sm-10\">\n            <input id=\"overview.firstName\" title=\"First name of logged user\" type=\"text\" name=\"firstName\" class=\"form-control\" placeholder=\"First name\" value=\"Julia\">\n        </div>\n    </div>\n    <div class=\"form-group row\">\n        <label id=\"overview.lastNameLabel\" for=\"overview.lastName\" class=\"col-sm-2 control-label\">Last name</label>\n        <div class=\"col-sm-10\">\n            <input id=\"overview.lastName\" title=\"Last name of logged user\" type=\"text\" name=\"lastName\" class=\"form-control\" placeholder=\"Last name\" value=\"Easyrider\">\n        </div>\n    </div>\n    <div class=\"form-group row\">\n        <label id=\"overview.emailLabel\" for=\"overview.email\" class=\"col-sm-2 control-label\">Email</label>\n        <div class=\"col-sm-10\">\n            <input id=\"overview.email\" title=\"email of logged user\" type=\"email\" name=\"email\" class=\"form-control\" placeholder=\"email@example.com\" value=\"easyrider@mail.edu\">\n        </div>\n    </div>\n    <div id=\"personalInfoFormSubmitField\" class=\"form-group row\">\n        <div class=\"col-sm-offset-2 col-sm-10\">\n            <button id=\"overview.saveButton\" type=\"submit\" class=\"btn btn-success\" title=\"Update personal information\">Update</button>\n        </div>\n    </div>\n</form>\n\n                \n                \n                \n                \n                \n                \n                \n                \n                \n            \n        </div>\n    </div>\n</div>\n\n<!-- Optional JavaScript -->\n<!-- jQuery first, then Popper.js, then Bootstrap JS -->\n<script src=\"/uis-web/js/jquery-3.1.1.slim.min.js\"></script>\n<script src=\"/uis-web/js/popper.min.js\"></script>\n<script src=\"/uis-web/js/bootstrap.min.js\"></script>\n\n\n\n"
