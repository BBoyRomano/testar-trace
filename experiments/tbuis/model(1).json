          "WebOuterHTML": "\n<!-- Top Menu -->\n\n\n\n\n\n\n\n<!-- Public menu style -->\n    <nav id=\"header\" class=\"navbar navbar-expand-md navbar-dark fixed-top bg-dark\">\n\n    <a id=\"header.title.logoTitle\" class=\"navbar-brand\" href=\"/uis-web/index.jsp\" title=\"Application home page\">University Information System</a>\n    <!-- Expand menu button for mobile devices -->\n    <button id=\"header.title.expandButton\" class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarsExampleDefault\" aria-controls=\"navbarsExampleDefault\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" title=\"Expand menu\">\n        <span class=\"navbar-toggler-icon\"></span>\n    </button>\n\n    <!-- Collapsible menu items -->\n    <div class=\"collapse navbar-collapse\" id=\"navbarsExampleDefault\">\n        <!-- Left side -->\n        <ul class=\"navbar-nav mr-auto\">\n            <li class=\"nav-item active\">\n                <a id=\"header.link.home\" title=\"Application home page\" class=\"nav-link\" href=\"/uis-web/index.jsp\">Home <span class=\"sr-only\">(current)</span></a>\n            </li>\n            \n                <li class=\"nav-item\">\n                    <a id=\"header.link.exportImport\" title=\"Export/Import data from/to DB\" class=\"nav-link\" href=\"/uis-web/import-export\">Export/Import DB </a>\n                </li>\n                <li class=\"nav-item\">\n                    <a id=\"header.link.restoreDB\" title=\"This button makes database restoring.\" class=\"nav-link\" href=\"/uis-web/restoreDB\">Restore DB </a>\n                </li>\n                <li class=\"nav-item\">\n                    <a id=\"header.link.login\" title=\"Login page\" class=\"nav-link\" href=\"/uis-web/login\">Login</a>\n                </li>\n            \n        </ul>\n        \n    </div>\n</nav>\n<!-- Page content -->\n<div id=\"main-content\" class=\"container\">\n    <!-- ALERTS -->\n    <!-- Bad login -->\n    \n    <!-- Logout successful -->\n    \n        <div id=\"loginPage.successAlert\" class=\"alert alert-success\" role=\"alert\">\n            <strong>Success!</strong> You have been successfully logged out.\n        </div>\n    \n\n    <h1 id=\"loginPage.title\">Login Page</h1>\n    <form id=\"loginPage.loginForm\" action=\"/uis-web/login\" method=\"post\">\n        <div id=\"loginPage.userNameField\" class=\"form-group\">\n            <label id=\"loginPage.usernameLabel\" for=\"loginPage.userNameInput\">Username</label>\n            <input type=\"text\" class=\"form-control\" id=\"loginPage.userNameInput\" name=\"username\" placeholder=\"Enter username\" title=\"Username of user\">\n        </div>\n        <div id=\"loginPage.passwordField\" class=\"form-group\">\n            <label id=\"loginPage.passwordLabel\" for=\"loginPage.passwordInput\">Password</label>\n            <input type=\"password\" class=\"form-control\" id=\"loginPage.passwordInput\" name=\"password\" placeholder=\"Enter password\" title=\"Password of user\">\n        </div>\n        <button id=\"loginPage.loginFormSubmit\" type=\"submit\" class=\"btn btn-primary\" title=\"Sign in to the application\">Login</button>\n    </form>\n</div>\n<!-- Optional JavaScript -->\n<!-- jQuery first, then Popper.js, then Bootstrap JS -->\n<!-- Bootstrap 4-->\n<script src=\"js/jquery-3.1.1.slim.min.js\"></script>\n<script src=\"js/popper.min.js\"></script>\n<script src=\"js/bootstrap.min.js\"></script>\n\n\n\n"
