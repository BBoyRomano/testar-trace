timeout 10.0
external 'extern'

def Type_Updated_into_label_last_name_to_Student_s_View()
  receive 'fill_in', constraint: %(selector == "" && value == "Updated")
  send 'page_title', constraint: %(_title == "Student's View")
end

def Left_Click_at_button_update_to_Student_s_View()
  receive 'click', constraint: %(css == "" && text == "button_update")
  send 'page_title', constraint: %(_title == "Student's View")
end

def Type_a_b_co_into_label_email_to_Teacher_s_View()
  receive 'fill_in', constraint: %(selector == "" && value == "a@b.co")
  send 'page_title', constraint: %(_title == "Teacher's View")
end

def Type_Teacher_into_label_first_name_to_Teacher_s_View()
  receive 'fill_in', constraint: %(selector == "" && value == "Teacher")
  send 'page_title', constraint: %(_title == "Teacher's View")
end

def Type_Updated_into_label_last_name_to_Teacher_s_View()
  receive 'fill_in', constraint: %(selector == "" && value == "Updated")
  send 'page_title', constraint: %(_title == "Teacher's View")
end

def Left_Click_at_button_update_to_Teacher_s_View()
  receive 'click', constraint: %(css == "" && text == "button_update")
  send 'page_title', constraint: %(_title == "Teacher's View")
end

def Type_a_b_co_into_label_email_to_Student_s_View()
  receive 'fill_in', constraint: %(selector == "" && value == "a@b.co")
  send 'page_title', constraint: %(_title == "Student's View")
end

def Type_Teacher_into_label_first_name_to_Student_s_View()
  receive 'fill_in', constraint: %(selector == "" && value == "Teacher")
  send 'page_title', constraint: %(_title == "Student's View")
end

process('testar') {

  channel('extern') {
    stimulus 'visit', '_url' => :string
    stimulus 'click', 'css' => :string, 'text' => :string
    stimulus 'fill_in', 'selector' => :string, 'value' => :string
    response 'page_title', '_title' => :string, '_url' => :string
  }

  behavior('launch') {
    receive 'visit',
    constraint: "_url == initial_url"
    send 'page_title',
    constraint: %(_title == "Teacher's View")
  }

  behavior('Student's View - SA1dj5wwg373965689568', :non_terminating) {
    repeat {
    }
  }

