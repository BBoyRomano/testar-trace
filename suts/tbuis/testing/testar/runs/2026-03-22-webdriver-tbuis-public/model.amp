timeout 10.0
external 'extern'

def Left_Click_at_a_application_constraints_to_Constraints()
  receive 'click', constraint: %(css == "[href='\/uis\/constraints\.jsp']" && text == "a_application_constraints")
  send 'page_title', constraint: %(_title == "Constraints")
end

def Left_Click_at_a_application_use_cases_to_Use_cases()
  receive 'click', constraint: %(css == "[href='\/uis\/use-cases\.jsp']" && text == "a_application_use-cases")
  send 'page_title', constraint: %(_title == "Use-cases")
end

def Left_Click_at_a_export_import_db_to_Import_Export_DB()
  receive 'click', constraint: %(css == "#header\.link\.exportImport" && text == "a_export/import_db")
  send 'page_title', constraint: %(_title == "Import-Export DB")
end

def Left_Click_at_a_university_information_system_to_University_information_system()
